# Slack app credentials (create the app from slack_app_manifest.yaml)
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...

# Personal Access Token (or v1 API key) from your PERSONAL Devin account:
# https://app.devin.ai/settings -> API / Personal Access Tokens
DEVIN_API_KEY=cog_...

# Optional
DEVIN_API_BASE=https://api.devin.ai/v1
POLL_INTERVAL_SECONDS=15
STATE_FILE=state.json
# Restrict who can use the bot (comma-separated Slack user IDs). Empty = anyone in the workspace.
ALLOWED_SLACK_USER_IDS=
